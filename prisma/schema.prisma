// NIVA Pregnancy Intelligence Platform — data model
// Current build: SQLite (sandbox). Production target: PostgreSQL (see docs/02-data-model.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & Access ───────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER") // USER | CLINICAL_REVIEWER | MODERATOR | SUPPORT | FINANCE | EDITOR | ADMIN | SUPER_ADMIN (Wave 6.2 role spectrum; ADMIN is kept for backward compat, SUPER_ADMIN manages roles)
  locale       String   @default("fa") // fa | en
  deactivatedAt DateTime? // Wave 6.2 user management: soft-disable (login/sessions blocked), data retained
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  consent          Consent?
  pregnancies      Pregnancy[]
  journalEntries   JournalEntry[]
  symptomEntries   SymptomEntry[]
  appointments     Appointment[]
  reminders        Reminder[]
  medicalDocuments MedicalDocument[]
  aiConversations  AIConversation[]
  communityPosts   CommunityPost[]
  subscriptions    Subscription[]
  entitlement      Entitlement?
  notifications    Notification[]
  auditEvents      AuditEvent[]
  grantsGiven      PartnerAccess[]   @relation("Granter")
  grantsReceived   PartnerAccess[]   @relation("Partner")
  reviewsAuthored  ClinicalReview[]  @relation("Reviewer")
  preference       Preference?
  safetyEvents     SafetyEvent[]
  postsModerated   CommunityPost[]   @relation("PostModerator")
  moderationActions ModerationAction[] @relation("Moderator")
  nutritionEntries NutritionEntry[]
  exerciseEntries  ExerciseEntry[]
  sleepEntries     SleepEntry[]
  moodEntries      MoodEntry[]
  birthPlanItems   BirthPlanItem[]
  contractionEntries ContractionEntry[]
  feedingEntries   FeedingEntry[]
  babyCareEntries  BabyCareEntry[]
  invoices         Invoice[]
  refundsProcessed Refund[]          @relation("RefundProcessor")
  tickets          SupportTicket[]   @relation("TicketOwner")
  ticketsAssigned  SupportTicket[]   @relation("TicketAssignee")
  ticketMessages   TicketMessage[]   @relation("TicketMessageAuthor")
  incidentsOpened  Incident[]        @relation("IncidentOpener")
  pushSubscriptions PushSubscription[]
}

model Session {
  id            String   @id @default(cuid())
  token         String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Consent {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion      String    @default("1.0")
  privacyVersion    String    @default("1.0")
  dataProcessing    Boolean   @default(true)
  healthAnalytics   Boolean   @default(false)
  marketing         Boolean   @default(false)
  familySharingAck  Boolean   @default(false)
  emailReminders    Boolean   @default(false) // consent for service emails (appointment/reminder nudges)
  birthYear         Int? // Wave 6.4 age gate: self-declared, min required age enforced at signup
  ageConfirmedAt    DateTime?
  withdrawnAt       DateTime?
  updatedAt         DateTime  @updatedAt
}

// ─── Pregnancy Core ──────────────────────────────────────────────────────────

model Pregnancy {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String    @default("My pregnancy")
  lmpDate          DateTime?
  dueDate          DateTime
  datingMethod     String    @default("LMP") // LMP | ULTRASOUND | CLINICIAN | IVF
  datingLocked     Boolean   @default(false) // true when clinician-established
  datingConfidence String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  datingNote       String?
  plurality        String    @default("SINGLETON") // SINGLETON | TWINS | TRIPLETS_OR_MORE
  status           String    @default("ACTIVE") // ACTIVE | POSTPARTUM | COMPLETED | LOSS
  outcomeAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events  PregnancyEvent[]
  datings GestationalDating[]

  @@index([userId])
}

model GestationalDating {
  id            String   @id @default(cuid())
  pregnancyId   String
  pregnancy     Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  method        String // LMP | ULTRASOUND_CRL | CLINICIAN | IVF
  referenceDate DateTime // LMP, scan date, transfer date, etc.
  crlMm         Float?
  dueDate       DateTime
  confidence    String // LOW | MEDIUM | HIGH
  source        String // SELF | CLINICIAN
  note          String?
  setAt         DateTime @default(now())

  @@index([pregnancyId])
}

model PregnancyEvent {
  id          String   @id @default(cuid())
  pregnancyId String
  pregnancy   Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  type        String // MILESTONE | SCAN | TEST_RESULT | SYMPTOM_NOTABLE | OTHER
  title       String
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([pregnancyId])
}

// ─── Health Tracking ─────────────────────────────────────────────────────────

model SymptomEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  week       Int?
  energy     Int? // 1..5
  nausea     Int? // 0..5
  sleep      Int? // 1..5
  mood       Int? // 1..5
  weightKg   Float?
  systolic   Int?
  diastolic  Int?
  kickCount  Int?
  symptoms   String   @default("[]") // JSON string array
  notes      String?
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String   @default("CHECKUP") // CHECKUP | ULTRASOUND | LAB | SPECIALIST | VACCINE | OTHER
  provider    String?
  location    String?
  scheduledAt DateTime
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | MISSED | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, scheduledAt])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("CUSTOM") // APPOINTMENT | SCREENING | SUPPLEMENT | MEDICATION | CUSTOM
  dueAt     DateTime
  repeat    String   @default("NONE") // NONE | DAILY | WEEKLY
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, dueAt])
}

model MedicalDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  category   String   @default("REPORT") // REPORT | ULTRASOUND | LAB | PRESCRIPTION | OTHER
  fileName   String
  fileType   String
  sizeKb     Int
  notes      String?
  uploadedAt DateTime @default(now())

  @@index([userId])
}

// ─── Content, Governance & 3D Assets ─────────────────────────────────────────

model EducationalContent {
  id            String    @id @default(cuid())
  slug          String    @unique
  week          Int?
  trimester     Int?
  category      String    @default("GENERAL")
  titleEn       String
  titleFa       String
  bodyEn        String
  bodyFa        String
  sources       String    @default("[]") // JSON [{citation,url,year}]
  evidenceGrade String    @default("C") // A (meta-analysis/systematic review) | B (cohort/RCT) | C (consensus/guideline) | D (educational consensus)
  status        String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | RETIRED
  version       Int       @default(1)
  reviewedAt    DateTime? // stamped by the approving clinical reviewer
  expiresAt     DateTime? // review-expiry: content past this date is suppressed until re-reviewed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([week])
}

model ScientificSource {
  id       String  @id @default(cuid())
  citation String
  org      String?
  url      String?
  year     Int?
}

model ClinicalReview {
  id          String    @id @default(cuid())
  contentType String // EDUCATIONAL_CONTENT | ANATOMICAL_ASSET | AI_RESPONSE
  contentId   String
  reviewerId  String?
  reviewer    User?     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED
  notes       String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([contentType, contentId])
  @@index([status])
}

model AnatomicalAsset {
  id                 String   @id @default(cuid())
  assetId            String   @unique
  gestationalStage   Int
  titleEn            String
  titleFa            String
  descriptionEn      String
  descriptionFa      String
  structures         String   @default("[]") // JSON string[]
  scientificSources  String   @default("[]") // JSON string[]
  reviewerName       String?
  reviewStatus       String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | DEMONSTRATION
  modelVersion       String   @default("1.0.0")
  animationMetadata  String   @default("{}") // JSON
  performanceProfile String   @default("{}") // JSON {lodTiers, maxVertsMobile}
  publicationStatus  String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── AI Assistant ────────────────────────────────────────────────────────────

model AIConversation {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String     @default("Conversation")
  language  String     @default("fa")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | ASSISTANT | SYSTEM
  content        String
  citations      String? // JSON [{title, citation, url}]
  safetyLevel    String   @default("NORMAL") // NORMAL | CAUTION | EMERGENCY
  flagged        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model SafetyEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // RED_FLAG_SYMPTOM | EMERGENCY_ESCALATION | AI_REFUSAL | INJECTION_ATTEMPT | MODERATION | PAYMENT_ANOMALY
  severity  String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  detail    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([resolved])
  @@index([userId])
}

// ─── AI Observability (Wave 3.2 — metadata only, PHI-free by design) ────────
// Never stores user message content, model output, or raw user IDs.
// userIdHash = HMAC-SHA256(userId, NIVA_AI_OBS_SALT) — pseudonymous, salted.

model AIUsageLog {
  id              String   @id @default(cuid())
  userIdHash      String?
  route           String   // 'chat'
  provider        String   // 'z-ai' | 'template-fallback'
  model           String?
  locale          String   @default("fa")
  promptChars     Int      @default(0)
  completionChars Int      @default(0)
  latencyMs       Int      @default(0)
  cacheHit        Boolean  @default(false)
  usedRetrieval   Boolean  @default(false)
  retrievalScores String   @default("[]") // JSON number[] — top-k similarity scores only
  safetyLevel     String   @default("NORMAL") // NORMAL | CAUTION | EMERGENCY
  errorCode       String?  // stable error code, never a message body
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([route, createdAt])
}

// ─── Journal & Wellbeing ─────────────────────────────────────────────────────

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  body      String
  mood      String? // GREAT | GOOD | NEUTRAL | LOW | STRUGGLING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// ─── Family & Community ──────────────────────────────────────────────────────

model PartnerAccess {
  id            String    @id @default(cuid())
  granterId     String
  granter       User      @relation("Granter", fields: [granterId], references: [id], onDelete: Cascade)
  partnerUserId String?   @unique
  partnerUser   User?     @relation("Partner", fields: [partnerUserId], references: [id], onDelete: SetNull)
  partnerEmail  String
  partnerName   String?
  permissions   String    @default("[]") // JSON string[]: VIEW_TIMELINE | VIEW_APPOINTMENTS | VIEW_TRACKING | VIEW_JOURNAL
  status        String    @default("INVITED") // INVITED | ACTIVE | REVOKED | DECLINED
  invitedAt     DateTime  @default(now())
  revokedAt     DateTime?
  declinedAt    DateTime?
  inviteToken   String?   @unique // single-use claim token; consumed on accept
  inviteExpiresAt DateTime?

  @@index([granterId])
  @@index([partnerEmail])
}

model CommunityPost {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorAlias    String
  topic          String    @default("GENERAL") // GENERAL | NUTRITION | SUPPORT | BIRTH | POSTPARTUM | PRODUCTS
  body           String
  language       String    @default("fa")
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | REMOVED
  flagCount      Int       @default(0)
  moderationNote String?
  moderatedById  String?
  moderatedBy    User?     @relation("PostModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationActions ModerationAction[]
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([topic])
}

model ModerationAction {
  id          String        @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  moderatorId String?
  moderator   User?         @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)
  action      String // APPROVE | REJECT | REMOVE | FLAG | AUTO_FLAG
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([postId])
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Subscription {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String    @default("FREE") // FREE | PREMIUM_MONTHLY | PREMIUM_ANNUAL | FAMILY
  status          String    @default("ACTIVE") // ACTIVE | TRIALING | PAST_DUE | CANCELLED | EXPIRED
  provider        String    @default("SANDBOX") // SANDBOX | ZARINPAL | STRIPE
  providerRef     String?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false) // Wave 6.1: user keeps access until currentPeriodEnd, then EXPIRED
  trialEndsAt     DateTime? // Wave 6.1: trial window (TRIALING status); null = no trial
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?
  payments        Payment[]
  invoices        Invoice[]

  @@index([userId])
}

model Payment {
  id             String    @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Int // minor units
  currency       String    @default("IRR") // IRR | USD
  status         String    @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  provider       String    @default("SANDBOX")
  providerRef    String?
  idempotencyKey String    @unique
  statusDetail   String? // Wave 6.1: PSP authority/verification code, reconciliation note
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  refunds        Refund[]
  invoice        Invoice?

  @@index([subscriptionId])
}

// ─── Wave 6.1: Invoices & Refunds ────────────────────────────────────────────

/// Issued automatically when a payment SUCCEEDS (sandbox or PSP webhook).
/// Numbers are sequential per year: NIVA-2026-000001.
model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentId      String    @unique
  payment        Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountMinor    Int
  currency       String    @default("IRR") // IRR | USD
  taxMinor       Int       @default(0) // VAT where applicable; 0 in sandbox
  status         String    @default("ISSUED") // ISSUED | VOID
  lineItems      String    @default("[]") // JSON: [{descriptionEn, descriptionFa, amountMinor, periodDays}]
  issuedAt       DateTime  @default(now())

  @@index([userId])
  @@index([subscriptionId])
}

/// Refunds are FINANCE-role operations only (Wave 6.2). Sandbox performs a
/// ledger-only refund; a real PSP call is the production swap-in point.
model Refund {
  id           String    @id @default(cuid())
  paymentId    String
  payment      Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountMinor  Int
  currency     String    @default("IRR")
  reason       String
  status       String    @default("SUCCEEDED") // PENDING | SUCCEEDED | FAILED (sandbox settles instantly)
  providerRef  String?
  processedById String? // FINANCE/SUPER_ADMIN actor
  processedBy  User?     @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([paymentId])
}

// ─── Wave 6.2: Support tickets & incidents ───────────────────────────────────

model SupportTicket {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     String    @default("OTHER") // BILLING | CLINICAL | TECHNICAL | PRIVACY | OTHER
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority     String    @default("NORMAL") // LOW | NORMAL | HIGH
  assignedToId String?
  assignee     User?     @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status, priority])
}

model TicketMessage {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isStaff   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([ticketId])
}

/// Platform incident log, surfaced in the admin overview; public status page
/// is a documented production target (not built in sandbox).
model Incident {
  id          String    @id @default(cuid())
  title       String
  description String
  severity    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String    @default("INVESTIGATING") // INVESTIGATING | IDENTIFIED | MONITORING | RESOLVED
  openedById  String
  openedBy    User      @relation("IncidentOpener", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// ─── Wave 6.5: Web push ──────────────────────────────────────────────────────

/// One browser push subscription per endpoint. Keys are stored server-side and
/// never leave it. Delivery uses VAPID (NIVA_PUSH_VAPID_PUBLIC/PRIVATE_KEY).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("fa") // fa | en — copy locale at subscribe time
  createdAt DateTime @default(now())

  @@index([userId])
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   @default("FREE")
  features  String   @default("{}") // JSON feature flags
  updatedAt DateTime @updatedAt
}

// ─── Platform Ops ────────────────────────────────────────────────────────────

model AuditEvent {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  metadata String? // JSON
  ip       String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

/// Anonymous, consent-gated landing analytics (backlog 1.8). Aggregate daily
/// counters only — no user id, no IP, no user agent, no cookies. Rows are
/// written exclusively by the public beacon endpoint after explicit consent.
model LandingMetric {
  id      String   @id @default(cuid())
  day     DateTime
  name    String
  variant String   @default("A")
  count   Int      @default(1)

  @@unique([day, name, variant])
  @@index([day])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String    @default("SYSTEM") // SYSTEM | APPOINTMENT | REVIEW | PAYMENT | SAFETY
  channel     String    @default("IN_APP") // IN_APP | EMAIL (EMAIL rows require Consent.emailReminders)
  scheduledFor DateTime? // set + sentAt null = pending scheduler job, hidden from feed
  sentAt      DateTime? // materialization timestamp (scheduler flips it when due)
  dedupeKey   String?   @unique // idempotent scheduler jobs, e.g. reminder:{id}:{dueAt}
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
  @@index([scheduledFor, sentAt])
}

// ─── Onboarding preferences (progressive profiling) ──────────────────────────

model Preference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     String   @default("PREGNANT") // TRYING | PREGNANT | POSTPARTUM | EXPLORING
  goals     String   @default("[]") // JSON string[] — module focus areas selected at onboarding
  units     String   @default("METRIC") // METRIC | IMPERIAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String // JSON
}

// ─── Wave 4: Wellness Trackers ──────────────────────────────────────────────

/// One row per user per local day (upsert by [userId, date]).
model NutritionEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime // local-day bucket (UTC midnight of that day)
  waterMl    Int      @default(0)
  fruits     Int      @default(0)
  vegetables Int      @default(0)
  protein    Int      @default(0)
  dairy      Int      @default(0)
  grains     Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model ExerciseEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  type      String   @default("WALK") // WALK | SWIM | YOGA | PILATES | STRENGTH | STRETCH | PELVIC_FLOOR | OTHER
  minutes   Int
  intensity String   @default("MODERATE") // LIGHT | MODERATE | VIGOROUS
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model SleepEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime // night-of local day
  hours         Float
  quality       Int      @default(3) // 1..5
  interruptions Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  mood      Int      @default(3) // 1..5
  energy    Int      @default(3) // 1..5
  anxiety   Int      @default(3) // 1..5
  tags      String   @default("[]") // JSON string[]
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Wave 4: Birth Prep & Baby ──────────────────────────────────────────────

/// Persistent checklist state; the checklist definitions live client-side.
model BirthPlanItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   @default("BIRTH_PLAN") // BIRTH_PLAN | HOSPITAL_BAG
  itemKey   String // stable slug from client checklist definition
  done      Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, itemKey])
  @@index([userId])
}

model ContractionEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  durationSec Int
  intensity   Int? // 1..5 self-reported
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, startedAt])
}

model FeedingEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fedAt       DateTime
  method      String   @default("BREAST") // BREAST | BOTTLE_BREASTMILK | BOTTLE_FORMULA | MIXED
  side        String   @default("NONE") // LEFT | RIGHT | BOTH | NONE
  durationMin Int?
  amountMl    Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, fedAt])
}

model BabyCareEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  happenedAt DateTime
  kind       String // DIAPER | SLEEP | BATH | WEIGHT | NOTE
  detail     String? // e.g. WET | SOILED | BOTH for DIAPER
  value      Float? // sleep hours / weight grams / numeric context
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, happenedAt])
}
